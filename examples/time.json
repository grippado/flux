{
  "name": "acme",
  "holistic_reviewer": "acme-pr-reviewer",
  "doc_reviewer": "acme-doc-reviewer",
  "answerer": "acme-pr-answerer",
  "slack_prospector": "acme-slack-prospector",
  "slack_answerer": "acme-slack-answerer",
  "specialists_root": "~/agents/acme/{repo}/repo-owner.md",
  "specialists_spec": "~/agents/acme/AGENT_SPEC.md",
  "specialists_repo": "acme/agent-suites",
  "kits_root": "~/agents/acme/kits/{repo}",
  "kits": [
    "~/.claude/plugins/acme-node-service-kit",
    "~/agents/acme/kits"
  ],
  "vault_root": "~/notes",
  "vault_context": "acme",
  "workspace_root": "~/code/acme",
  "linear_org": "acme",
  "linear_ops": "~/code/acme/plugins/core/shared/LINEAR-OPS.md",
  "scope_escalation": "SDD completo em ~/code/acme/technical-refining (rode /sdd por lá)",
  "repos": [
    "api-gateway",
    "web-monorepo",
    "notifications",
    "payments"
  ],
  "exec_command": "workflow",
  "exec_fallback": {
    "default": "meu-time:implement",
    "payments": "acme:payments-implement"
  },
  "no_emdash": true,
  "write_destinations": {
    "~/agents/acme": {
      "repos": [
        "api-gateway",
        "web-monorepo"
      ],
      "approved_at": "2026-08-10",
      "guards": {
        "symlink": "n/a",
        "git_repo": "confirmado: acme/agent-suites",
        "dotfiles_dir": "n/a"
      }
    }
  }
}
